{
  "name": "teolingo-v2.2",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push:sqlite",
    "db:push:turso": "drizzle-kit push:sqlite",
    "db:migrate:add-quiz-is-active": "bun run src/infrastructure/database/migrations/add-quiz-is-active.ts",
    "db:migrate:add-quiz-update-metadata": "bun run src/infrastructure/database/migrations/add-quiz-update-metadata.ts",
    "db:migrate:add-user-password-reset": "bun run src/infrastructure/database/migrations/add-user-password-reset.ts",
    "db:seed": "bun run src/infrastructure/database/seed.ts",
    "db:seed:safe": "bun run src/infrastructure/database/seed.ts --preserve-progress",
    "db:seed:reset": "bun run src/infrastructure/database/seed.ts --reset-progress",
    "db:seed:roadmap": "bun run src/infrastructure/database/seed-sections.ts roadmap",
    "db:seed:israeli": "bun run src/infrastructure/database/seed-sections.ts israeli",
    "db:seed:practice:all": "bun run src/infrastructure/database/seed-sections.ts practice:all",
    "db:seed:practice:freq-1": "bun run src/infrastructure/database/seed-sections.ts practice:freq-1",
    "db:seed:practice:freq-2": "bun run src/infrastructure/database/seed-sections.ts practice:freq-2",
    "db:seed:practice:freq-3": "bun run src/infrastructure/database/seed-sections.ts practice:freq-3",
    "db:seed:practice:freq-4": "bun run src/infrastructure/database/seed-sections.ts practice:freq-4",
    "db:seed:practice:freq-5": "bun run src/infrastructure/database/seed-sections.ts practice:freq-5",
    "db:seed:practice:freq-6": "bun run src/infrastructure/database/seed-sections.ts practice:freq-6",
    "db:seed:practice:freq-7": "bun run src/infrastructure/database/seed-sections.ts practice:freq-7",
    "db:seed:practice:freq-8": "bun run src/infrastructure/database/seed-sections.ts practice:freq-8",
    "db:seed:practice:nouns": "bun run src/infrastructure/database/seed-sections.ts practice:nouns",
    "db:seed:practice:adjectives": "bun run src/infrastructure/database/seed-sections.ts practice:adjectives",
    "db:seed:practice:prefixes": "bun run src/infrastructure/database/seed-sections.ts practice:prefixes",
    "db:seed:practice:pronouns": "bun run src/infrastructure/database/seed-sections.ts practice:pronouns",
    "db:seed:practice:suffixes": "bun run src/infrastructure/database/seed-sections.ts practice:suffixes",
    "db:seed:quizzes": "bun run src/infrastructure/database/seed-quizzes.ts",
    "db:seed:practice:verbs": "bun run src/infrastructure/database/seed-sections.ts practice:verbs",
    "db:seed:practice:imperfect": "bun run src/infrastructure/database/seed-sections.ts practice:imperfect",
    "db:seed:practice:verb-suffixes": "bun run src/infrastructure/database/seed-sections.ts practice:verb-suffixes",
    "db:seed:ime:alphabet": "bun run src/infrastructure/database/seed-sections.ts ime:alphabet",
    "db:seed:ime:rhythms": "bun run src/infrastructure/database/seed-sections.ts ime:rhythms",
    "db:setup": "bun run db:push && bun run db:seed",
    "db:setup:turso": "bun run db:push:turso && bun run db:seed",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "0.14.0",
    "bcryptjs": "2.4.3",
    "canvas-confetti": "1.9.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.30.10",
    "jose": "5.10.0",
    "lucide-react": "0.562.0",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.20.18",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  },
  "trustedDependencies": ["@biomejs/biome", "es5-ext"]
}
